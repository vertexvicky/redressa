# ══════════════════════════════════════════════════════════════
# AI Call Engine — Environment Configuration
# ══════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ─── API Authentication ──────────────────────────────────────
# Secret token for authenticating external application requests
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_TOKEN=change-me-to-a-secure-random-token

# ─── Voice AI Provider ───────────────────────────────────────
# Provider: "vapi" | "mock"
VOICE_PROVIDER=mock

# Vapi Configuration (required when VOICE_PROVIDER=vapi)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# ─── Call Settings ────────────────────────────────────────────
# Default language for AI calls: en | hi | ta
DEFAULT_LANGUAGE=en
# Maximum call duration in seconds
MAX_CALL_DURATION=300
# Maximum retry attempts for failed calls
MAX_RETRY_ATTEMPTS=3
# Retry delay base in milliseconds (exponential backoff)
RETRY_DELAY_BASE_MS=5000

# ─── Rate Limiting ───────────────────────────────────────────
# Maximum requests per window per IP
RATE_LIMIT_MAX=100
# Rate limit window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Database ────────────────────────────────────────────────
# SQLite database file path
DATABASE_PATH=./data/ai-call-engine.sqlite

# ─── Demo Mode ───────────────────────────────────────────────
# Set to true to enable demo/mock mode (no real calls)
DEMO_MODE=true

# ─── Redressa Status Callback Webhook (Optional) ──────────────
CALLBACK_WEBHOOK_URL=http://localhost:8787/api/v1/integrations/ai-call-engine/webhook
CALLBACK_WEBHOOK_SECRET=change-me-to-a-webhook-hmac-secret
