{
  "name": "@redressa/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply redressa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply redressa-db --remote"
  },
  "dependencies": {
    "@google/genai": "^0.14.1",
    "@redressa/shared": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.6",
    "jose": "^6.0.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250409.0",
    "drizzle-kit": "^0.30.6",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1",
    "wrangler": "^4.12.0"
  }
}
